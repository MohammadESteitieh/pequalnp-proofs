open PEqualNP.Library.LRAT PEqualNP.Library.LRAT.Link

private def edgeFn (x : Fin 5 → Bool) : Bool :=
  (x 0 && x 2) || (x 0 && x 3) || (x 0 && x 4) ||
  (x 1 && x 2) || (x 1 && x 3) || (x 1 && x 4)

-- Minimal true and maximal false rows, with input zero in the low bit.
private def rows : List ℕ := [3,5,6,9,10,17,18,28]

